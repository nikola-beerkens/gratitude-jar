{
  "name": "gratitude-jar",
  "version": "1.0.1",
  "description": "A gratitude jar that lets you store and reflect on daily moments of thankfulness.",
  "main": "main.js",
  "author": "Nikola Beerkens",
  "license": "ISC",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "build": {
    "appId": "com.teggl.gratitudejar",
    "productName": "Gratitude Jar",
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "directories": {
      "buildResources": "build"
    }
  },
  "devDependencies": {
    "electron": "^35.1.4",
    "electron-builder": "^24.13.2"
  },
  "dependencies": {
    "electron-log": "^5.3.3",
    "electron-store": "^10.0.1"
  }
}
